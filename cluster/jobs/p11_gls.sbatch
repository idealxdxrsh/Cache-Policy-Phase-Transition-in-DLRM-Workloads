#!/bin/bash -l
#SBATCH -p compute
#SBATCH -N 1 -n 1 -c 4   # compute QOS cpulimit: min 4 CPUs (vvp uses one)
#SBATCH -o /scratch/rahulkmr/Adarsh/p11gls/slurm/%x_%A_%a.out
# P11 part B: one functional gate-level simulation (zero delay, cell models generated by Yosys 0.33 from the
# NanGate45 liberty, locally, in P5f) of a v3 netlist in lockstep with the v3 RTL on one 200,000-request slice
# (synthesis/p11/tb_gls_slice.sv). Array task SLURM_ARRAY_TASK_ID (1-based) = line of the task list "<run> <slice>",
# run = d<D>_m<M>_<F>MHz. Exit 1 unless the run prints GLS SLICE LOCKSTEP PASSED, so the afterok arrays of the
# larger depths do not start after a failure (cluster/p11_driver.sh). Times and peak memory: tools/timev.py.
#   sbatch --array=1-8 ... p11_gls.sbatch <tasklist>
set -uo pipefail
G=/scratch/rahulkmr/Adarsh/p11gls
E=/home/rahulkmr/.conda/envs/rtl_sim/bin
read -r run slice < <(sed -n "${SLURM_ARRAY_TASK_ID}p" "$1")
d=${run#d}; d=${d%%_*}; m=${run#*_m}; m=${m%%_*}
w=$G/work/${run}_$slice; o=$G/results/${run}_$slice.txt; mkdir -p "$w" "$G/results"
cd "$w" || exit 1
tf=$G/stim/$slice.hex
{
echo "# P11 gls_slice ${run} ${slice}: v3 netlist vs v3 RTL, functional gate-level simulation, zero delay"
echo "job ${SLURM_ARRAY_JOB_ID:-?}_${SLURM_ARRAY_TASK_ID:-?} host $(hostname) cpus ${SLURM_CPUS_PER_TASK:-?} mem ${SLURM_MEM_PER_NODE:-?} MB"
echo "iverilog: $($E/iverilog -V 2>&1 | head -n 1)"
echo "netlist sha256: $(sha256sum "$G/netlists/$run/netlist.v" | cut -d' ' -f1)"
echo "rtl sha256: $(sha256sum "$G/rtl/lfu_cache_controller.v" | cut -d' ' -f1)"
echo "trace sha256: $(sha256sum "$tf" | cut -d' ' -f1)"
"$E/python3" -I "$G/tools/p5f_wrap.py" "$G/netlists/$run/netlist.v" "$d" "$m" "$w" || { echo "wrap failed"; exit 1; }
echo "== compile"
"$E/python3" -I "$G/tools/timev.py" "$E/iverilog" -g2012 -Ptb_gls_slice.COUNTER_MODE=$m -Ptb_gls_slice.CACHE_DEPTH=$d \
    -o "$w/sim.vvp" "$G/models/nangate45_cells_yosys.v" "$w/netlist_gl.v" "$G/rtl/lfu_cache_controller.v" \
    "$G/tb/tb_gls_slice.sv" > iverilog.txt 2> compile_time.txt
rc=$?
grep -v timescale iverilog.txt | sort | uniq -c | head -n 20
grep -E "Elapsed|Maximum resident|Exit status" compile_time.txt
if [ $rc = 0 ]; then
    echo "== run"
    "$E/python3" -I "$G/tools/timev.py" "$E/vvp" -n sim.vvp "+trace=$tf" "+nreq=$(grep -c . "$tf")" \
        "+hitlog=$w/hits.txt" > vvp.txt 2> run_time.txt
    echo "vvp exit=$?"
    grep -E "Elapsed|Maximum resident|Exit status" run_time.txt
    grep -v '^\$finish\|finish called' vvp.txt | tail -n 40
    echo "hitlog: lines $(wc -l < hits.txt) sha256 $(sha256sum hits.txt | cut -c1-64)"
fi
} > "$o" 2>&1
rm -f "$w/sim.vvp" "$w/netlist_gl.v"
grep -q "GLS SLICE LOCKSTEP PASSED" "$o"
